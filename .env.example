APP_NAME=sx-case-similarity
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
STATE_DIR=./data/app_state
PROMPT_DIR=./prompts

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_HTTPS=false
QDRANT_API_KEY=
QDRANT_COLLECTION=xinfang_cases
QDRANT_DENSE_VECTOR_NAME=dense_vector
QDRANT_SPARSE_VECTOR_NAME=sparse_vector
QDRANT_DENSE_VECTOR_SIZE=1024

LLM_BASE_URL=http://model-mock:9000/v1
EMBEDDING_BASE_URL=http://model-mock:9000/v1
RERANK_BASE_URL=http://model-mock:9000/v1
LLM_MODEL=qwen3-8b-awq
EMBEDDING_MODEL=bge-m3
RERANK_MODEL=bge-reranker-v2-m3
MODEL_API_KEY=EMPTY
HTTP_TIMEOUT_SECONDS=60

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=sjw
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_SOURCE_TABLE=case_similarity_source
MYSQL_WTXX_TABLE=t_xf_wtxx
MYSQL_XFJ_TABLE=t_xf_xfj
MYSQL_ACTIVE_STATUSES=ACTIVE
MYSQL_POOL_MIN_SIZE=1
MYSQL_POOL_MAX_SIZE=5
MYSQL_CONNECT_TIMEOUT_SECONDS=5
DECRYPT_PROVIDER=noop

FILTER_YEARS=5
RRF_K=60
HYBRID_LIMIT=50
RERANK_TOP_N=20
JUDGE_TOP_N=5
SYNC_BATCH_SIZE=32
IDENTIFY_CONCURRENCY=1
LOCK_TIMEOUT_SECONDS=0.05
